#!/bin/sh

show_error() {
  zenity --error --title="Internet Shortcut" --text="$1"
}

if [ "$#" -ne 1 ]; then
  show_error "Expected one Internet Shortcut file."
  exit 1
fi

shortcut=$1
if [ ! -r "$shortcut" ]; then
  show_error "Unable to read the Internet Shortcut file: $shortcut"
  exit 1
fi

if ! url=$(awk '
  {
    sub(/\r$/, "")
    if ($0 == "[InternetShortcut]") {
      in_shortcut = 1
    } else if ($0 ~ /^\[/) {
      in_shortcut = 0
    } else if (in_shortcut && $0 ~ /^URL[[:space:]]*=/) {
      sub(/^[^=]*=/, "")
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }
  }
' < "$shortcut" 2>/dev/null); then
  show_error "Unable to read the Internet Shortcut file: $shortcut"
  exit 1
fi

if [ -z "$url" ]; then
  show_error "No URL was found in the Internet Shortcut file: $shortcut"
  exit 1
fi

if ! xdg-open "$url"; then
  show_error "Unable to open the URL: $url"
  exit 1
fi
